				<IsLowMemory>true</IsLowMemory>
			</PlatformOptimizationData>	    
			<PlatformOptimizationData Name="Moderate">
				<Platforms>
					<string>iPad3</string>
					<string>ANDROID_2Gb</string>
				</Platforms>
				<MaxMMO>15</MaxMMO>
				<MaxFullMMO>0</MaxFullMMO>
